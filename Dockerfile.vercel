# syntax=docker/dockerfile:1
#
# Vercel deployment target - see VERCEL_DEPLOY.md for the full story.
#
# This is a SEPARATE image from the root Dockerfile (used by Render) and
# does not affect it. Two real architectural differences from the Render
# deployment, both required by Vercel's serverless/container model (a
# request-scoped container, not a long-lived VM):
#   - No Laravel Reverb (websocket server) - Vercel can't host a persistent
#     process, and nothing in this app currently depends on it yet (it was
#     scaffolded for a future phase, never wired to a real feature - see
#     resources/js/bootstrap.ts's guard).
#   - No in-process queue worker - QUEUE_CONNECTION=sync instead, so any
#     future dispatch() call just runs inline during the request rather
#     than being queued for a worker that doesn't exist here. Nothing in
#     the app dispatches a queued job today, so this is a no-op change in
#     practice, not a removed feature.
#
###############################################################################
# Stage 1: build frontend assets (Vite -> public/build)
###############################################################################
FROM node:20-alpine AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Deliberately NOT copying .env.production here (unlike the root
# Dockerfile) - that file bakes in VITE_REVERB_* for the Render/Reverb
# deployment. Leaving those unset makes resources/js/bootstrap.ts skip
# creating an Echo/Pusher-js client entirely, which is exactly right for a
# deployment target with no Reverb server to connect to.
RUN npm run build

###############################################################################
# Stage 2: install PHP dependencies
###############################################################################
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.jso[n] composer.loc[k] ./
RUN composer install --no-dev --no-scripts --no-autoloader --ignore-platform-reqs --optimize-autoloader

COPY . .
RUN composer dump-autoload --optimize --no-dev

###############################################################################
# Stage 3: runtime image (FrankenPHP, per Vercel's Laravel+Docker guide)
###############################################################################
FROM dunglas/frankenphp:1-php8.3-bookworm AS runtime

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions pdo_pgsql pgsql intl zip gd bcmath mbstring

WORKDIR /app

COPY --from=vendor --chown=www-data:www-data /app /app
COPY --from=frontend --chown=www-data:www-data /app/public/build /app/public/build
COPY --chown=www-data:www-data Caddyfile.vercel /etc/frankenphp/Caddyfile

RUN mkdir -p storage/framework/{cache,sessions,testing,views} storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Config caching is deliberately skipped (see VERCEL_DEPLOY.md) - `php
# artisan config:cache` would freeze env vars at BUILD time, but Vercel
# injects real env vars at RUNTIME, not build time.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    DB_CONNECTION=pgsql \
    CACHE_STORE=database \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync \
    BROADCAST_CONNECTION=null \
    PUBLIC_DISK_DRIVER=s3 \
    AWS_DEFAULT_REGION=auto \
    AWS_USE_PATH_STYLE_ENDPOINT=true

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
